<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE tsung SYSTEM "/usr/share/tsung/tsung-1.0.dtd">
<tsung loglevel="notice" version="1.0">
  <clients>
    <client host="localhost" use_controller_vm="true" maxusers="20"/>
  </clients>

  <servers>
    <server host="localhost" port="8081" type="tcp"/>
  </servers>

  <load>
    <arrivalphase phase="1" duration="30" unit="second">
      <users arrivalrate="1" unit="second"/>
    </arrivalphase>
  </load>

  <sessions>
    <session name="consulta-ficha-vehiculo" probability="100" type="ts_http">
      <request>
        <http url="/api/v1/vehiculos/ficha?id=1" method="GET" version="1.1">
          <http_header name="Authorization" value="Bearer REEMPLAZAR_CON_JWT_DE_PRUEBAS"/>
        </http>
      </request>
      <thinktime value="2" random="true"/>
    </session>
  </sessions>
</tsung>
